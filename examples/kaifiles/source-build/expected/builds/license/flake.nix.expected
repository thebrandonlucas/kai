{
  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
  inputs."kai-source-kai".url = "github:thebrandonlucas/kai/d2355d304f3ad952b6f5a45e8c1d75de5768e7a6";
  inputs."kai-source-kai".flake = false;
  outputs = inputs@{ nixpkgs, ... }: {
    kaiSources = { "kai" = inputs."kai-source-kai"; };
    legacyPackages."{{system}}" = nixpkgs.legacyPackages."{{system}}";
    devShells."{{system}}".default = nixpkgs.legacyPackages."{{system}}".mkShell {
      packages = [
      ];
    };
  };
}