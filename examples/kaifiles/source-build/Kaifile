# Source inputs are locked by `kai update` and exposed only to builds that select them.
source kai {
  url: "github:thebrandonlucas/kai/d2355d304f3ad952b6f5a45e8c1d75de5768e7a6"
}

environment copy {
  packages: []
}

build license {
  environment: copy
  inputs: ["kai"]
  run: ["cp", ".kai/inputs/kai/LICENSE", "LICENSE"]
  output: "LICENSE"
}
