# Source inputs are locked by `kai update` and exposed only to builds that select them.
source kai {
  url: "github:thebrandonlucas/kai/658c5989aef03406f56f9c17556422e662616f41"
}

environment copy {
  packages: []
}

build license {
  environment: copy
  inputs: ["kai"]
  run: ["cp", ".kai/inputs/kai/LICENSE", "LICENSE"]
  output: "LICENSE"
}
