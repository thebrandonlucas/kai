# Configure the package source used by every Nix command.
backend nix {
  packages: "github:NixOS/nixpkgs/nixos-unstable-small"
}

# Nix is the default backend, but it can also be selected explicitly.
#
# Run this environment with `kai shell nix`.
#
# This is important because in future we could/will have other sources
# for the determinate backend e.g. `guix`, or even a custom kai implementation!
shell nix {
  packages: ["cowsay", "fortune"]
}
