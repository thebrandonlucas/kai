{
  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
  outputs = { nixpkgs, ... }:
    let
      system = "x86_64-linux";
      pkgs = import nixpkgs {
        inherit system;
        overlays = [
        ];
      };
      machine = nixpkgs.lib.nixosSystem {
        inherit system;
        modules = [
          { nixpkgs.pkgs = pkgs; }
          ({ modulesPath, ... }: {
            imports = [
              (modulesPath + "/profiles/qemu-guest.nix")
              (modulesPath + "/virtualisation/disk-image.nix")
            ];
            image.baseName = "server";
          })
          ./machine.nix
        ];
      };
    in {
      nixosConfigurations."server" = machine;
      kaiImages."server" = {
        kind = "machine-image";
        name = "server";
        format = "qcow2";
        inherit system;
        image = machine.config.system.build.image;
      };
    };
}