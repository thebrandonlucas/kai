{ config, ... }:
{
  sops.secrets."greeting".restartUnits = [ "greeter.service" ];
  systemd.services."greeter" = {
    wantedBy = [ "multi-user.target" ];
    serviceConfig = {
      Type = "exec";
      ExecStart = "${./artifact}";
      Restart = "on-failure";
      DynamicUser = true;
      NoNewPrivileges = true;
      PrivateDevices = true;
      PrivateTmp = true;
      ProtectControlGroups = true;
      ProtectHome = true;
      ProtectKernelModules = true;
      ProtectKernelTunables = true;
      ProtectSystem = "strict";
      RestrictSUIDSGID = true;
      UMask = "0077";
      LoadCredential = [
        "greeting:${config.sops.secrets."greeting".path}"
      ];
    };
  };
}