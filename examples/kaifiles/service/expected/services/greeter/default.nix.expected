let
  flake = builtins.getFlake (toString ../../../.kai/builds/greeter);
  pkgs = builtins.getAttr "{{system}}" flake.legacyPackages;
in
pkgs.runCommand "kai-service-greeter" {} ''
  mkdir -p "$out"
  cp -- ${./module.nix} "$out/default.nix"
  cp --recursive --no-dereference --preserve=mode ${./artifact} "$out/artifact"
  if [ ! -f "$out/artifact" ] || [ ! -x "$out/artifact" ]; then
    echo "Kai service artifact must be an executable file" >&2
    exit 1
  fi
''