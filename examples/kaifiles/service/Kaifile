# Build a hardened NixOS service module with `kai service greeter`.
environment tools {
  packages: ["coreutils"]
}

build greeter {
  environment: tools
  run: [
    "sh",
    "-c",
    "printf '#!/bin/sh\\necho hello\\n' > greeter && chmod +x greeter"
  ]
  output: "greeter"
}

# Kai decrypts the SOPS-encrypted value at runtime.
secret greeting {
  provider: sops
  file: "secrets/greeting.json"
}

service greeter {
  artifact: "greeter"
  secrets: ["greeting"]
  restart: on-failure
}
