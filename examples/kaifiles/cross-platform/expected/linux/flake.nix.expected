{
  inputs.nixpkgs.url = "{{nixpkgs}}";
  outputs = { nixpkgs, ... }: {
    devShells."{{system}}".default = nixpkgs.legacyPackages."{{system}}".mkShell {
      packages = [
              nixpkgs."legacyPackages"."{{system}}"."cowsay"
              nixpkgs."legacyPackages"."{{system}}"."fortune"
      ];
    };
  };
}