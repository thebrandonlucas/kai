environment cow {
 packages: ["cowsay", "fortune"]
}

environment poke {
 packages: ["pokemonsay", "fortune"]
}

task moo {
 environment: "cow"
 run: ["cowsay", "$(fortune)"]
}

task pika {
 environment: "poke"
 run: ["pokemonsay", "$(fortune)"]
}

build kai {
  environment: poke,
  run: ["roc", "build", "./xkai/main.roc", "--opt=size", "--output=xkai-dev"],
  output: "."
}
